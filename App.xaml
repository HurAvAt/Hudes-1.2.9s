<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="HudesNative.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:HudesNative">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
   </ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <BitmapImage x:Key="BrandLockup" UriSource="ms-appx:///Assets/hudes-logo.png"/>
     <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F8FB"/>
     <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="CardBrush" Color="#EFF4F9"/>
     <SolidColorBrush x:Key="ControlBrush" Color="#E4ECF5"/>
     <SolidColorBrush x:Key="SelectedBrush" Color="#CFE7FA"/>
     <SolidColorBrush x:Key="AccentBrush" Color="#396C91"/>
     <SolidColorBrush x:Key="InkBrush" Color="#0B1727"/>
     <SolidColorBrush x:Key="MutedBrush" Color="#536579"/>
     <SolidColorBrush x:Key="BorderBrush" Color="#CDD8E5"/>
     <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
     <SolidColorBrush x:Key="TextControlBackground" Color="#F9FBFD"/>
     <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="TextControlForeground" Color="#0B1727"/>
     <SolidColorBrush x:Key="TextControlBorderBrush" Color="#AFC1D2"/>
     <SolidColorBrush x:Key="ComboBoxBackground" Color="#F9FBFD"/>
     <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="ComboBoxForeground" Color="#0B1727"/>
     <SolidColorBrush x:Key="FlyoutBackground" Color="#FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <BitmapImage x:Key="BrandLockup" UriSource="ms-appx:///Assets/hudes-logo-dark.png"/>
     <SolidColorBrush x:Key="SurfaceBrush" Color="#0D1724"/>
     <SolidColorBrush x:Key="PanelBrush" Color="#111E2C"/>
     <SolidColorBrush x:Key="CardBrush" Color="#172535"/>
     <SolidColorBrush x:Key="ControlBrush" Color="#1E3145"/>
     <SolidColorBrush x:Key="SelectedBrush" Color="#2A4B65"/>
     <SolidColorBrush x:Key="AccentBrush" Color="#8EC5EB"/>
     <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="MutedBrush" Color="#CAD7E5"/>
     <SolidColorBrush x:Key="BorderBrush" Color="#344A60"/>
     <SolidColorBrush x:Key="DangerBrush" Color="#FFB4AB"/>
     <SolidColorBrush x:Key="TextControlBackground" Color="#1C2B3B"/>
     <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#223548"/>
     <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#24394E"/>
     <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#CAD7E5"/>
     <SolidColorBrush x:Key="TextControlBorderBrush" Color="#49647E"/>
     <SolidColorBrush x:Key="ComboBoxBackground" Color="#1C2B3B"/>
     <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#223548"/>
     <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#294158"/>
     <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#172535"/>
     <SolidColorBrush x:Key="FlyoutBackground" Color="#172535"/>
     <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#172535"/>
     <SolidColorBrush x:Key="CalendarViewBackground" Color="#172535"/>
     <SolidColorBrush x:Key="CalendarViewDayItemForeground" Color="#FFFFFF"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/></Style>
   <Style TargetType="Button"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource ControlBrush}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/></Style>
   <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource SelectedBrush}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="13,7"/></Style>
   <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource TextControlBackground}"/><Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
   <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource TextControlBackground}"/><Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource ComboBoxBackground}"/><Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
   <Style TargetType="CalendarDatePicker" BasedOn="{StaticResource DefaultCalendarDatePickerStyle}"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource TextControlBackground}"/><Setter Property="BorderBrush" Value="{ThemeResource TextControlBorderBrush}"/></Style>
   <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource FlyoutBackground}"/><Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}"/></Style>
   <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}"><Setter Property="Foreground" Value="{ThemeResource InkBrush}"/><Setter Property="Background" Value="{ThemeResource FlyoutBackground}"/></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
