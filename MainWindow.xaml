      <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="13">
       <Border.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Name="CopyItemPathMenu" Text="Copy file path" Click="CopyFileAddress_Click"/><MenuFlyoutItem x:Name="CopyContainingPathMenu" Text="Copy containing folder path" Click="CopyLocationAddress_Click"/></MenuFlyout></Border.ContextFlyout>
       <StackPanel>
       <TextBlock Text="SELECTED FILE" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/>
