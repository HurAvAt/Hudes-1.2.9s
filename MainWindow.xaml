    <Border x:Name="DetailsGrip" HorizontalAlignment="Right" Width="5" Background="{ThemeResource BorderBrush}" PointerPressed="Splitter_PointerPressed" PointerMoved="Splitter_PointerMoved" PointerReleased="Splitter_PointerReleased" PointerCaptureLost="Splitter_PointerReleased"/>
