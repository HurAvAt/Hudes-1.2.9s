       <Button x:Name="OptionGroupSelect" Content="Group selecting" Click="SelectGroups_Click" Margin="4,0" Padding="11,6"/>
       <Button x:Name="OptionTagSelect" Content="Tag selecting" Click="SelectTags_Click" Margin="4,0" Padding="11,6"/>
       <StackPanel x:Name="OptionSelect" Orientation="Horizontal" Margin="4,0"><ToggleButton x:Name="SelectModeButton" Content="Select" Click="SelectMode_Click" Padding="12,6"/></StackPanel>
      </StackPanel>
      <StackPanel x:Name="FileOptionsRow2" Orientation="Horizontal" HorizontalAlignment="Center"/>
      <StackPanel x:Name="FileOptionsRow3" Orientation="Horizontal" HorizontalAlignment="Center"/>
      <Border x:Name="DefinitionPanel" Visibility="Collapsed" Padding="14" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12"/>
     </StackPanel>
     <Border x:Name="FileSurface" Grid.Row="2" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="0,10,0,0" Padding="10" AllowDrop="True" DragOver="FileView_DragOver" Drop="FileView_Drop" Tapped="FileSurface_Tapped" RightTapped="FileSurface_RightTapped">
      <Grid>
