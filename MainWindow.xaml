       </Grid>
       <Grid x:Name="TerminalSurface" Grid.Row="1"><TextBlock x:Name="TerminalNotice" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
      </Grid></Grid>
     </Border>
    </Grid>
