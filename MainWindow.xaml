    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Search notes &amp; tags" FontSize="12" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,14,0,14" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="10"><StackPanel Spacing="5" Width="175"><TextBox x:Name="SearchGroupFind" PlaceholderText="Find group filter" TextChanged="DefinitionFind_Changed"/><ComboBox x:Name="SearchGroupFilter" HorizontalAlignment="Stretch" SelectionChanged="SearchFilter_Changed"/></StackPanel><StackPanel Spacing="5" Width="165"><TextBox x:Name="SearchTagFind" PlaceholderText="Find tag filter" TextChanged="DefinitionFind_Changed"/><ComboBox x:Name="SearchTagFilter" HorizontalAlignment="Stretch" SelectionChanged="SearchFilter_Changed"/></StackPanel><ComboBox x:Name="SearchStatusFilter" MinWidth="135" VerticalAlignment="Bottom" SelectionChanged="SearchFilter_Changed"><ComboBoxItem Content="All statuses"/><ComboBoxItem Content="New"/><ComboBoxItem Content="Ongoing"/><ComboBoxItem Content="Done"/><ComboBoxItem Content="Important"/><ComboBoxItem Content="Emergency"/></ComboBox><Button Content="Clear filters" VerticalAlignment="Bottom" Click="ClearSearchFilters_Click"/></StackPanel><Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="14,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="12" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" FontSize="12" TextChanged="SearchBox_TextChanged"/></Grid></Border></StackPanel>
    <ListView Grid.Row="2" x:Name="SearchResults" Background="Transparent" BorderThickness="0" DoubleTapped="SearchResults_DoubleTapped"/>
   </Grid>

   <Grid x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" Margin="42,28"><Grid.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False"/></TransitionCollection></Grid.Transitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0"><StackPanel MaxWidth="920" HorizontalAlignment="Left" Spacing="10">
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18"><StackPanel>
      <TextBlock Text="FOLDERS" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/>
      <TextBlock Text="App desktop folder" Margin="0,8,0,0"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DesktopFolderBox" IsReadOnly="True"/><Button Grid.Column="1" Content="Browse…" Click="BrowseDesktopFolder_Click" Background="{ThemeResource SelectedBrush}" Margin="8,0,0,0"/></Grid>
      <TextBlock Text="Starting folder" Margin="0,10,0,0"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DefaultFolderBox" IsReadOnly="True"/><Button Grid.Column="1" Content="Browse…" Click="BrowseStartFolder_Click" Background="{ThemeResource SelectedBrush}" Margin="8,0,0,0"/></Grid>
     </StackPanel></Border>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="REMINDERS" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/><TextBlock Text="Red-clock warning window in hours" Margin="0,8,0,0"/></StackPanel><TextBox x:Name="ReminderHoursBox" Grid.Column="1" HorizontalContentAlignment="Center" VerticalAlignment="Bottom"/></Grid></Border>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18"><StackPanel Spacing="10">
      <TextBlock Text="Terminal" FontSize="18" FontWeight="SemiBold"/>
      <CheckBox x:Name="ShowTerminalCheck" Content="Show terminal rail on Home"/>
      <ComboBox x:Name="ShellChoice" Header="Installed command environment" HorizontalAlignment="Stretch"/>
     </StackPanel></Border>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18"><StackPanel><CheckBox x:Name="ShowNotebookCheck" Content="Show notes panel on Home"/><TextBlock Text="NOTE DEFAULTS" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="Default note direction" VerticalAlignment="Center"/><ComboBox x:Name="DefaultDirectionCombo" Grid.Column="1"><ComboBoxItem Content="LTR"/><ComboBoxItem Content="RTL"/></ComboBox></Grid></StackPanel></Border>
     <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,8,0,0"/>
     <Expander Header="Light mode · colors and fonts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel x:Name="LightAppearancePanel" Spacing="8"/></Expander>
     <Expander Header="Dark mode · colors and fonts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel x:Name="DarkAppearancePanel" Spacing="8"/></Expander>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18"><StackPanel><TextBlock Text="SECURITY" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/><CheckBox x:Name="WindowsHelloCheck" Content="Offer Windows Hello on the lock screen" Margin="0,9,0,6"/><CheckBox x:Name="PasswordRequiredCheck" Content="Require a password when Hudes starts or is locked" Margin="0,0,0,12"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Current password" Margin="0,0,0,5"/><PasswordBox x:Name="CurrentPasswordBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="New password" Margin="0,0,0,5"/><PasswordBox x:Name="NewPasswordBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Repeat new password" Margin="0,0,0,5"/><PasswordBox x:Name="ConfirmPasswordBox"/></StackPanel>
     </Grid><Button Content="Change password" Click="ChangePassword_Click" Background="{ThemeResource SelectedBrush}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18">
      <StackPanel Spacing="8">
       <TextBlock Text="DATABASE" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/>
       <TextBlock x:Name="DatabasePathText" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
       <TextBlock x:Name="DatabaseProtectionText" TextWrapping="Wrap"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ProtectDatabaseButton" Content="Set database password…" Click="ProtectDatabase_Click"/>
        <Button x:Name="RemoveDatabasePasswordButton" Content="Remove password…" Visibility="Collapsed" Click="RemoveDatabasePassword_Click"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Back up database…" Click="BackupDatabase_Click" Background="{ThemeResource SelectedBrush}"/>
        <Button Content="Restore database…" Click="RestoreDatabase_Click"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18">
      <StackPanel Spacing="8">
       <TextBlock Text="NEW FILES" FontWeight="SemiBold"/>
       <TextBox x:Name="NewFileBaseBox" Header="Default name before [number]"/>
       <TextBox x:Name="ExtensionPresetsBox" Header="Extension presets (one Name = .extension per line)" AcceptsReturn="True" Height="116" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18">
      <StackPanel Spacing="8">
       <TextBlock Text="WORKSPACE EXPORT" FontWeight="SemiBold"/>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="ExportPathBox" Header="Destination outside Hudes Desktop"/>
        <Button Grid.Column="1" Content="Browse…" Click="BrowseExportFolder_Click" VerticalAlignment="Bottom"/>
       </Grid>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="ExportFormatCombo" Header="Metadata format"><ComboBoxItem Content="CSV"/><ComboBoxItem Content="XLSX"/></ComboBox>
        <TextBox x:Name="ExportLimitBox" Header="Records per file" Width="146"/>
        <Button Content="Export workspace…" Click="ExportWorkspace_Click" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <Border Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18"><StackPanel Spacing="10"><TextBlock Text="LAUNCH SHORTCUTS" FontWeight="SemiBold"/><TextBlock Text="Slots 1–6 appear left of Home and Search. Slots 7–12 appear right." TextWrapping="Wrap"/><TextBox x:Name="BashExecutableBox" Header="Bash executable (optional; otherwise Git Bash or bash.exe on PATH)"/><StackPanel x:Name="ShortcutSettingsPanel" Spacing="6"/></StackPanel></Border>
     <StackPanel x:Name="SettingsSaveArea" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,24" Spacing="10">
      <FlyoutBase.AttachedFlyout><Flyout x:Name="SettingsSavedFlyout" Placement="Top"><StackPanel MinWidth="210" Spacing="9"><TextBlock x:Name="SettingsSavedText" Text="Settings saved" TextWrapping="Wrap"/><Button Content="OK" Click="SettingsSavedDismiss_Click" HorizontalAlignment="Right" Padding="13,5"/></StackPanel></Flyout></FlyoutBase.AttachedFlyout>
      <Button Content="Save settings" Click="SaveSettings_Click" Style="{StaticResource PrimaryButtonStyle}"/>
      <Button Content="Reset to defaults" Click="ResetSettings_Click"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>

  </ContentControl>
  <Grid x:Name="LockOverlay" Background="{ThemeResource SurfaceBrush}" Canvas.ZIndex="10" Visibility="Collapsed">
   <Border Width="370" Padding="24" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="12">
     <Image Source="{ThemeResource BrandLockup}" Width="148" Height="62" Stretch="Uniform" HorizontalAlignment="Center"/>
     <StackPanel x:Name="ManualLockPanel" Spacing="12" Visibility="Collapsed">
      <TextBlock Text="Hudes is locked" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <Button x:Name="ResumeLoginButton" Content="Login" Click="ResumeLogin_Click" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" MinWidth="116"/>
     </StackPanel>
     <StackPanel x:Name="SignInPanel" Spacing="12">
      <TextBlock Text="Sign in to Hudes" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center" Margin="0,-10,0,12"/>
      <PasswordBox x:Name="LoginPasswordBox" PlaceholderText="Password" PasswordRevealMode="Peek" KeyDown="LoginPassword_KeyDown"/>
      <Button Content="Unlock" Click="Unlock_Click" Style="{StaticResource PrimaryButtonStyle}"/>
      <Button x:Name="HelloButton" Content="Use Windows Hello" Click="Hello_Click"/>
      <TextBlock Text="Default password: 1111" FontSize="10" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
      <TextBlock x:Name="LoginErrorText" Foreground="{ThemeResource DangerBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>

  <Grid x:Name="FirstRunOverlay" Background="{ThemeResource SurfaceBrush}" Visibility="Collapsed" Canvas.ZIndex="11">
   <Border Width="520" Padding="38" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="12"><Image Source="{ThemeResource BrandLockup}" Width="190" Height="86" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="Choose your Desktop folder" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Hudes will treat this as your workspace and will keep its archive folder here." Foreground="{ThemeResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/><TextBox x:Name="FirstRunFolderBox" IsReadOnly="True"/><Button Content="Choose folder…" Click="FirstRunBrowse_Click" Background="{ThemeResource SelectedBrush}"/><Button x:Name="FirstRunContinueButton" Content="Continue" Click="FirstRunContinue_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False"/></StackPanel></Border>
  </Grid>
 </Grid>
</Window>
