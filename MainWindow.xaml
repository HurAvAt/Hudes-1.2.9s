    <Button x:Name="NotesRail" Grid.Column="3" Content="&#xE70B;" FontFamily="Segoe Fluent Icons" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Open notes" ToolTipService.ToolTip="Open notes"/>
