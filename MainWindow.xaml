        <Button.Resources>
         <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF957E"/>
         <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#EF694F"/>
         <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#A43829"/>
         <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#912E22"/>
         <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#271412"/>
         <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#271412"/>
        </Button.Resources>
        <StackPanel Orientation="Horizontal" Spacing="7">
         <FontIcon Glyph="&#xEB51;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" Foreground="#271412"/>
