       <StackPanel>
        <TextBlock Text="ORGANIZE" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Button x:Name="ManageGroupsButton" Content="Group" Click="CreateGroup_Click" Background="{ThemeResource SelectedBrush}" Margin="0,0,4,0"/>
         <Button x:Name="ManageTagsButton" Grid.Column="1" Content="Tags" Click="CreateTags_Click" Margin="4,0,0,0"/>
        </Grid>
       </StackPanel>
      </Border>
       </StackPanel>
      </Border>
      <Border x:Name="NotePreviewPanel" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="13" Visibility="Collapsed">
       <StackPanel><TextBlock Text="FILE NOTE" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold"/><TextBlock x:Name="NotePreviewText" FontFamily="Dubai" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0"/><Border x:Name="TagPreviewPanel" Background="{ThemeResource PanelBrush}" CornerRadius="8" Padding="8" Margin="0,10,0,0"><StackPanel><TextBlock Text="TAGS · click to filter" FontSize="10" Foreground="{ThemeResource MutedBrush}"/><ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TagChipsPanel" Spacing="4" Margin="0,6,0,0"/></ScrollViewer></StackPanel></Border><TextBlock x:Name="NotePreviewTagsText" FontFamily="Dubai" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed"/></StackPanel>
      </Border>
      <Border x:Name="MetadataPanel" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="13" Visibility="Collapsed">
       <StackPanel>
        <Grid><TextBlock Text="NOTE" FontSize="10" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="EditNoteButton" Content="Edit" Click="EditNote_Click" Visibility="Collapsed" Height="27" MinHeight="0" Padding="8,2" Margin="0,0,6,0"/><Button x:Name="DirectionButton" Content="RTL" Click="Direction_Click" Width="48" Height="27" MinHeight="0" Padding="5,2" Background="{ThemeResource SelectedBrush}"/></StackPanel></Grid>
