       <Button x:Name="LinkSelected" Content="Link selected files" HorizontalAlignment="Stretch"/>
       <StackPanel x:Name="DraftFiles" Spacing="4"/>
       <TextBlock x:Name="NoteError" TextWrapping="Wrap" Foreground="{ThemeResource DangerBrush}"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CommitPanelNote" Content="Save note" Style="{StaticResource PrimaryButtonStyle}"/><Button x:Name="CancelPanelNote" Content="Cancel"/></StackPanel>
      </StackPanel></ScrollViewer>
     </Grid></Grid>
    </Border>
    <Grid Grid.Row="1" Grid.ColumnSpan="4">
     <Button x:Name="TerminalRail" Content="&gt;_   Terminal" MinHeight="24" Height="26" Padding="14,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Open terminal" ToolTipService.ToolTip="Open terminal"/>
