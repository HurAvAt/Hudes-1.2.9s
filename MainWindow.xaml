        <TextBox x:Name="NoteGroupFind" PlaceholderText="Find a group" Visibility="Collapsed" Margin="0,0,0,5" TextChanged="DefinitionFind_Changed"/>
        <ComboBox x:Name="NoteGroupCombo" IsEnabled="False" HorizontalAlignment="Stretch"/>
        <TextBlock Text="Tags" FontSize="10" Foreground="{ThemeResource MutedBrush}" Margin="1,9,0,4"/>
