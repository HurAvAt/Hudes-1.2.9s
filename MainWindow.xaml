   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
    <Grid Margin="16,0" ColumnSpacing="10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="134"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Click="Lock_Click" HorizontalAlignment="Left" VerticalAlignment="Center" UseSystemFocusVisuals="True" AutomationProperties.Name="Lock Hudes" ToolTipService.ToolTip="Lock Hudes">
      <Button.Template>
       <ControlTemplate TargetType="Button">
        <ContentPresenter Background="Transparent" Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
       </ControlTemplate>
      </Button.Template>
      <StackPanel Spacing="2">
       <Image Source="{ThemeResource BrandLockup}" Width="128" Height="30" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/>
       <TextBlock x:Name="DesignCredit" Text="design by HurAvAt" FontSize="10" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Grid x:Name="LeftShortcuts" Grid.Column="1" ColumnSpacing="6" Margin="0,8"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="HomeTabButton" Content="⌂  Home" Click="HomeTab_Click" Background="{ThemeResource SelectedBrush}" Margin="3"/>
