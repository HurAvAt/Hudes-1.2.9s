       <StackPanel x:Name="OptionView" Orientation="Horizontal" Margin="4,0"><TextBlock Text="View" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="ViewCombo" Width="120" SelectionChanged="View_Changed"><ComboBoxItem Content="Large icons"/><ComboBoxItem Content="Small icons"/><ComboBoxItem Content="List"/><ComboBoxItem Content="Details"/></ComboBox></StackPanel>
